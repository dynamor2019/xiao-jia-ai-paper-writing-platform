{
  "name": "xiao-jia-ai-paper-writing-platform",
  "version": "0.1.8",
  "description": "小贾AI科研论文写作平台：面向科技论文研究、写作、校验、导出与投稿的一站式 DSH 工作台",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "tsc",
    "test:updates": "node --test scripts/platform-updater.test.mjs",
    "release:source": "node scripts/package-platform-update.mjs",
    "test:models": "tsx --test src/config/model-routing.test.ts src/lib/model-client.test.ts src/lib/model-client-context.test.ts src/lib/model-request-policy.test.ts scripts/model-credentials.test.mjs scripts/project-env.test.mjs scripts/paper-model-env.test.mjs scripts/verify-model-routing.test.mjs scripts/web-model-router.test.mjs scripts/model-dependency-lock.test.mjs scripts/model-request-budget.test.mjs scripts/paper-context-memory.test.mjs scripts/context-prefix-cache.test.mjs scripts/setup-model-dependencies.test.mjs scripts/packaged-model-baseline.test.mjs",
    "test:pipeline": "tsx --test src/workflows/phase-progress.test.ts src/workflows/phase-runner.test.ts src/workflows/result-interpretation.test.ts src/workflows/artifact-inventory.test.ts src/workflows/experiment-plan.test.ts src/workflows/delivery-gates.test.ts src/workflows/planned-experiment-integration.test.ts scripts/paper-workbench-state.test.mjs",
    "test:startup": "node --test scripts/startup-patches.test.mjs scripts/shared-runtime-guard.test.mjs scripts/patch-dsh-workbench-events.test.mjs scripts/publication-guards.test.mjs scripts/paper-phases-ui.test.mjs scripts/verify-model-routing.test.mjs",
    "setup": "node scripts/setup-dsh.mjs",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "web": "node scripts/launch-dsh.mjs",
    "desktop": "electron .",
    "predesktop:pack": "node scripts/packaged-model-baseline.mjs",
    "predesktop:pack:local": "node scripts/packaged-model-baseline.mjs",
    "predesktop:pack:github": "node scripts/packaged-model-baseline.mjs",
    "predesktop:dir": "node scripts/packaged-model-baseline.mjs",
    "desktop:pack": "node scripts/package-desktop.mjs",
    "desktop:pack:local": "node scripts/package-desktop.mjs",
    "desktop:pack:github": "electron-builder --dir --win --x64",
    "desktop:dir": "node scripts/package-desktop.mjs --dir",
    "web:autostart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-dsh-autostart.ps1",
    "figures:install": "node scripts/install-figures4papers.mjs",
    "pylustrator:install": "node scripts/setup-dsh.mjs --pylustrator-only",
    "cleanup": "node scripts/cleanup-dsh-data.mjs --dry-run",
    "cleanup:apply": "node scripts/cleanup-dsh-data.mjs --apply",
    "cleanup:dedupe": "node scripts/cleanup-dsh-data.mjs --dedupe-exact",
    "cleanup:dedupe:apply": "node scripts/cleanup-dsh-data.mjs --dedupe-exact --apply",
    "cleanup:schedule": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-dsh-cleanup-task.ps1",
    "custom:protect": "node scripts/protect-dsh-customizations.mjs snapshot",
    "custom:verify": "node scripts/protect-dsh-customizations.mjs verify",
    "custom:restore": "node scripts/protect-dsh-customizations.mjs restore && node scripts/sync-dsh-runtime.mjs",
    "update:dsh": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/update-dsh-safe.ps1",
    "sync:dsh": "node scripts/sync-dsh-runtime.mjs",
    "word": "npm run build --silent && node scripts/md-to-docx.mjs",
    "paper": "node scripts/paper-cli.mjs",
    "paper:cli": "node scripts/paper-cli.mjs",
    "paper:validate": "tsx src/workflows/validate-paper.ts",
    "model:health": "npm run build --silent && node scripts/model-health-check.mjs",
    "test": "tsx --test src/plugins/writing/academic-style.test.ts src/plugins/writing/section-writer.test.ts src/workflows/canonical-draft.test.ts src/workflows/polish-checkpoint.test.ts src/workflows/quality-review-progress.test.ts src/plugins/verification/scientific-quality-reviewer.test.ts src/plugins/verification/citation-verifier.test.ts src/plugins/verification/paper-quality-validator.test.ts src/plugins/research/research-lifecycle.test.ts src/plugins/research/topic-evaluation.test.ts src/lib/model-client.test.ts scripts/paper-integration.test.mjs src/plugins/verification/review-consistency.test.ts src/workflows/scientific-review-gate.test.ts src/workflows/nonblocking-review.test.ts src/workflows/final-review-feedback.test.ts src/plugins/export/docx-exporter.test.ts src/workflows/delivery-review-evidence.test.ts src/workflows/submission-wait.test.ts src/workflows/literature-completeness.test.ts src/workflows/literature-revision.test.ts src/workflows/pending-question.test.ts src/workflows/manuscript-authors.test.ts src/workflows/result-artifact.test.ts scripts/cleanup-dsh-data.test.mjs scripts/periodic-cleanup.test.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "agent",
    "paper",
    "academic"
  ],
  "author": "",
  "license": "MIT",
