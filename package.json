    "@deepseek-ai/dsh-llm-deepseek-account": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-llm-deepseek-api-key": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.2-alpha.3",
