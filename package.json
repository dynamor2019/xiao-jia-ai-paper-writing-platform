{
  "name": "xiao-jia-ai-paper-writing-platform",
  "version": "0.1.0",
  "description": "小贾AI科研论文写作平台：面向科技论文研究、写作、校验、导出与投稿的一站式 DSH 工作台",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-dsh.ps1",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "web": "node scripts/start-dsh-web.mjs",
    "web:autostart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-dsh-autostart.ps1",
    "figures:install": "node scripts/install-figures4papers.mjs",
    "pylustrator:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-pylustrator.ps1",
    "cleanup": "node scripts/cleanup-dsh-data.mjs --dry-run",
    "cleanup:apply": "node scripts/cleanup-dsh-data.mjs --apply",
    "cleanup:schedule": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-dsh-cleanup-task.ps1",
    "custom:protect": "node scripts/protect-dsh-customizations.mjs snapshot",
    "custom:verify": "node scripts/protect-dsh-customizations.mjs verify",
    "custom:restore": "node scripts/protect-dsh-customizations.mjs restore && node scripts/sync-dsh-runtime.mjs",
    "update:dsh": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/update-dsh-safe.ps1",
    "sync:dsh": "node scripts/sync-dsh-runtime.mjs",
    "word": "npm run build --silent && node scripts/md-to-docx.mjs",
    "paper": "tsx src/workflows/paper-pipeline.ts",
    "paper:cli": "tsx src/workflows/paper-pipeline.ts",
    "paper:validate": "tsx src/workflows/validate-paper.ts",
    "model:health": "npm run build --silent && node scripts/model-health-check.mjs",
    "test": "tsx --test src/plugins/verification/paper-quality-validator.test.ts src/plugins/research/research-lifecycle.test.ts src/lib/model-client.test.ts"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "agent",
    "paper",
    "academic"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "1.0.2",
    "@deepseek-ai/dsh": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-anonymous-user-id": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-atomic-write": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-authorization": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-bash-local": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-code-runtime": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-compaction": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-fs": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-invariants": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-jobs": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-output-retention": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-sandbox": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-scope": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session-telemetry": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session-title-llm": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-shell": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-spill": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-subagent-in-process-driver": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-timeout": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-tool-jobs": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-workflow": "^0.1.2-rc.1",
    "dotenv": "^17.4.2",
    "dsh-univer-office": "^0.2.14",
    "mammoth": "^1.12.1",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
