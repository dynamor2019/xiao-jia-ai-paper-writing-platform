{
  "name": "xiao-jia-ai-paper-writing-platform",
  "version": "0.1.7",
  "description": "小贾AI科研论文写作平台：面向科技论文研究、写作、校验、导出与投稿的一站式 DSH 工作台",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "tsc",
    "test:pipeline": "tsx --test src/workflows/phase-progress.test.ts src/workflows/phase-runner.test.ts src/workflows/result-interpretation.test.ts src/workflows/artifact-inventory.test.ts src/workflows/experiment-plan.test.ts src/workflows/delivery-gates.test.ts src/workflows/planned-experiment-integration.test.ts scripts/paper-workbench-state.test.mjs",
    "test:startup": "node --test scripts/startup-patches.test.mjs scripts/shared-runtime-guard.test.mjs scripts/patch-dsh-workbench-events.test.mjs scripts/publication-guards.test.mjs scripts/paper-phases-ui.test.mjs",
    "setup": "node scripts/setup-dsh.mjs",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "web": "node scripts/start-dsh-web.mjs",
    "desktop": "electron .",
    "desktop:pack": "node scripts/package-desktop.mjs",
    "desktop:pack:local": "node scripts/package-desktop.mjs",
    "desktop:pack:github": "electron-builder --dir --win --x64",
    "desktop:dir": "node scripts/package-desktop.mjs --dir",
    "web:autostart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-dsh-autostart.ps1",
    "figures:install": "node scripts/install-figures4papers.mjs",
    "pylustrator:install": "node scripts/setup-dsh.mjs --pylustrator-only",
    "cleanup": "node scripts/cleanup-dsh-data.mjs --dry-run",
    "cleanup:apply": "node scripts/cleanup-dsh-data.mjs --apply",
    "cleanup:schedule": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-dsh-cleanup-task.ps1",
    "custom:protect": "node scripts/protect-dsh-customizations.mjs snapshot",
    "custom:verify": "node scripts/protect-dsh-customizations.mjs verify",
    "custom:restore": "node scripts/protect-dsh-customizations.mjs restore && node scripts/sync-dsh-runtime.mjs",
    "update:dsh": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/update-dsh-safe.ps1",
    "sync:dsh": "node scripts/sync-dsh-runtime.mjs",
    "word": "npm run build --silent && node scripts/md-to-docx.mjs",
    "paper": "node scripts/paper-cli.mjs",
    "paper:cli": "node scripts/paper-cli.mjs",
    "paper:validate": "tsx src/workflows/validate-paper.ts",
    "model:health": "npm run build --silent && node scripts/model-health-check.mjs",
    "test": "tsx --test src/plugins/writing/academic-style.test.ts src/plugins/writing/section-writer.test.ts src/workflows/canonical-draft.test.ts src/workflows/polish-checkpoint.test.ts src/workflows/quality-review-progress.test.ts src/plugins/verification/scientific-quality-reviewer.test.ts src/plugins/verification/citation-verifier.test.ts src/plugins/verification/paper-quality-validator.test.ts src/plugins/research/research-lifecycle.test.ts src/plugins/research/topic-evaluation.test.ts src/lib/model-client.test.ts scripts/paper-integration.test.mjs src/plugins/verification/review-consistency.test.ts src/workflows/scientific-review-gate.test.ts src/workflows/nonblocking-review.test.ts src/workflows/final-review-feedback.test.ts src/plugins/export/docx-exporter.test.ts src/workflows/delivery-review-evidence.test.ts src/workflows/submission-wait.test.ts src/workflows/literature-completeness.test.ts src/workflows/literature-revision.test.ts src/workflows/pending-question.test.ts src/workflows/manuscript-authors.test.ts"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "agent",
    "paper",
    "academic"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "1.0.2",
    "@deepseek-ai/dsh": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-anonymous-user-id": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-attachment": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-compaction": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-deepseek-account": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-fs": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-jobs": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-llm-deepseek": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-output-retention": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-ptc-runtime": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-sandbox": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-session-persistence": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-session-query": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-session-telemetry": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-session-title-llm": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-shell": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-spill": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-subagent-in-process-driver": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-util-time": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-workflow": "^0.1.7-rc.2",
    "dotenv": "^17.4.2",
    "dsh-univer-office": "^0.3.5",
    "eventsource-parser": "^3.1.1",
    "mammoth": "^1.12.1",
    "pdf-parse": "^2.4.5",
    "tsx": "^4.16.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3",
    "typescript": "^5.5.0"
  },
  "build": {
    "appId": "com.xiaojia.ai.paper",
    "productName": "小贾AI科研论文写作平台",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "scripts/**/*",
      "config/**/*",
      ".dsh/**/*",
      "src/**/*",
      "dist/**/*",
      "knowledge-base/**/*",
      "package.json",
      "package-lock.json",
      ".env.example",
      "tsconfig.json",
      "!release/**/*",
      "!output/**/*",
      "!papers/input/**/*",
      "!.env"
    ],
    "asar": false,
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": "portable",
      "icon": "config/dsh/assets/xiaojia-desktop-icon.png"
    },
    "portable": {
      "artifactName": "小贾AI科研论文写作平台-${version}-Windows.exe"
    }
  }
}
