  "devDependencies": {
    "@types/node": "^20.0.0",
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3",
    "typescript": "^5.5.0"
  },
  "build": {
    "appId": "com.xiaojia.ai.paper",
    "productName": "小贾AI科研论文写作平台",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "scripts/**/*",
      "config/**/*",
      ".dsh/**/*",
      "src/**/*",
      "dist/**/*",
      "knowledge-base/**/*",
      "package.json",
      "package-lock.json",
      ".env.example",
      "tsconfig.json",
      "!release/**/*",
      "!output/**/*",
      "!papers/input/**/*",
      "!**/*.bak",
      "!**/__pycache__/**/*",
      "!**/*.pyc",
      "!**/*.log",
      "!.env"
    ],
    "asar": false,
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": "portable",
      "icon": "config/dsh/assets/xiaojia-desktop-icon.png"
    },
    "portable": {
      "artifactName": "小贾AI科研论文写作平台-${version}-Windows.exe"
    }
  }
}
