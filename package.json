    "@deepseek-ai/dsh-workspace": "0.2.2-alpha.3",
    "@deepseek-ai/schemastery": "3.18.4",
    "@earendil-works/pi-ai": "0.87.1",
    "dotenv": "^17.4.2",
    "dsh-univer-office": "^0.3.5",
    "eventsource-parser": "^3.1.1",
    "mammoth": "^1.12.1",
    "pdf-parse": "^2.4.5",
