# OpenAI-compatible writing pipeline
# 支持官方 OpenAI，也支持中转站；中转站必须保留 /v1 结尾。
# 例: OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=max
OPENAI_USE_RESPONSES_API=true

# Anthropic-compatible independent scientific review
# 支持官方 Anthropic，也支持 Claude 中转站；若中转站提供 OpenAI-compatible Claude，可设 ANTHROPIC_API_MODE=openai。
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_API_MODE=anthropic

# Per-stage routing
ROUTE_SUMMARY_PROVIDER=openai
ROUTE_SUMMARY_MODEL=gpt-5.6-luna
ROUTE_OUTLINE_PROVIDER=openai
ROUTE_OUTLINE_MODEL=gpt-5.6-terra
ROUTE_WRITING_PROVIDER=openai
ROUTE_WRITING_MODEL=gpt-5.6-terra
ROUTE_COHERENCE_PROVIDER=openai
ROUTE_COHERENCE_MODEL=gpt-5.6-luna
ROUTE_CITATION_PROVIDER=openai
ROUTE_CITATION_MODEL=gpt-5.6-terra
ROUTE_QUALITY_PROVIDER=claude
ROUTE_QUALITY_MODEL=claude-opus-5
ROUTE_POLISH_PROVIDER=openai
ROUTE_POLISH_MODEL=gpt-5.6-luna

# Workspace and export
DSH_PAPER_PROJECT_DIR=
PAPER_DATA_ROOT=
PAPER_STATE_DIR=.dsh-state
PAPER_INPUT_DIR=papers\input
OUTPUT_DIR=output
PANDOC_PATH=
PANDOC_REFERENCE_DOC=
DSH_PYLUSTRATOR_PYTHON=
DSH_PYLUSTRATOR_HELPER=

# Reliability
# 付费中转站默认不自动重试，避免不确定状态下重复计费
MODEL_MAX_RETRIES=0
MODEL_TIMEOUT_MS=120000
MODEL_STRICT_OUTPUT=true
# 后台论文流水线遇到 TRANSPORT/503/429/timeout/empty response 时从断点自动续跑
PAPER_BACKGROUND_MAX_RECOVERIES=72
PAPER_BACKGROUND_RETRY_BASE_MS=60000
PAPER_BACKGROUND_RETRY_MAX_MS=900000
EXPERIMENT_TIMEOUT_MS=3600000
ROUTE_DISCOVERY_PROVIDER=openai
ROUTE_DISCOVERY_MODEL=gpt-5.6-sol
ROUTE_PROTOCOL_PROVIDER=claude
ROUTE_PROTOCOL_MODEL=claude-opus-5
